---
/**
 * CaseImages.astro — Image Stack do case study (Figma 78:2686).
 * Desktop: 1250 wide, 590 tall cada bloco, gap 15.
 *   Image 1 (full) → Row [Image 2 + Image 3] → Image 4 (full) → Row [Image 5 + Image 6]
 * Tablet/Mobile: tudo empilha em coluna única (imagens full-width, mantendo ratio).
 */

import { Image } from 'astro:assets';

interface CaseMedia {
  type?: 'image' | 'video';
  src: string;
  alt?: string;
}

interface Props {
  media: [CaseMedia, CaseMedia, CaseMedia, CaseMedia, CaseMedia, CaseMedia];
}

const { media } = Astro.props;
const [m1, m2, m3, m4, m5, m6] = media;

const isVideo = (m: CaseMedia) => m.type === 'video';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/cases/**/*.{jpeg,jpg,png,webp}', { eager: true });

const resolveImage = (m: CaseMedia) => {
  if (m.type === 'video' || !m.src.startsWith('/cases/')) return null;
  const imageModule = images[`/src/assets${m.src}`];
  return imageModule ? imageModule.default : null;
};
---

<section class="case_images-section">
  <div class="case_images-stack">
    <div class="case_image case_image--full">
      {isVideo(m1) ? (
        <video muted loop playsinline preload="metadata" autoplay><source src={m1.src} type="video/mp4" /></video>
      ) : resolveImage(m1) ? (
        <Image src={resolveImage(m1)!} alt={m1.alt || ''} widths={[540, 720, 1080, 1440]} sizes="(max-width: 579px) 540px, (max-width: 1023px) 720px, (max-width: 1600px) 1080px, 1440px" quality={90} loading="lazy" />
      ) : null}
    </div>

    <div class="case_image-row">
      <div class="case_image case_image--half">
        {isVideo(m2) ? (
          <video muted loop playsinline preload="metadata" autoplay><source src={m2.src} type="video/mp4" /></video>
        ) : resolveImage(m2) ? (
          <Image src={resolveImage(m2)!} alt={m2.alt || ''} widths={[540, 720, 1080, 1440]} sizes="(max-width: 579px) 540px, (max-width: 1023px) 720px, (max-width: 1600px) 1080px, 1440px" quality={90} loading="lazy" />
        ) : null}
      </div>
      <div class="case_image case_image--half">
        {isVideo(m3) ? (
          <video muted loop playsinline preload="metadata" autoplay><source src={m3.src} type="video/mp4" /></video>
        ) : resolveImage(m3) ? (
          <Image src={resolveImage(m3)!} alt={m3.alt || ''} widths={[540, 720, 1080, 1440]} sizes="(max-width: 579px) 540px, (max-width: 1023px) 720px, (max-width: 1600px) 1080px, 1440px" quality={90} loading="lazy" />
        ) : null}
      </div>
    </div>

    <div class="case_image case_image--full">
      {isVideo(m4) ? (
        <video muted loop playsinline preload="metadata" autoplay><source src={m4.src} type="video/mp4" /></video>
      ) : resolveImage(m4) ? (
        <Image src={resolveImage(m4)!} alt={m4.alt || ''} widths={[540, 720, 1080, 1440]} sizes="(max-width: 579px) 540px, (max-width: 1023px) 720px, (max-width: 1600px) 1080px, 1440px" quality={90} loading="lazy" />
      ) : null}
    </div>

    <div class="case_image-row">
      <div class="case_image case_image--half">
        {isVideo(m5) ? (
          <video muted loop playsinline preload="metadata" autoplay><source src={m5.src} type="video/mp4" /></video>
        ) : resolveImage(m5) ? (
          <Image src={resolveImage(m5)!} alt={m5.alt || ''} widths={[540, 720, 1080, 1440]} sizes="(max-width: 579px) 540px, (max-width: 1023px) 720px, (max-width: 1600px) 1080px, 1440px" quality={90} loading="lazy" />
        ) : null}
      </div>
      <div class="case_image case_image--half">
        {isVideo(m6) ? (
          <video muted loop playsinline preload="metadata" autoplay><source src={m6.src} type="video/mp4" /></video>
        ) : resolveImage(m6) ? (
          <Image src={resolveImage(m6)!} alt={m6.alt || ''} widths={[540, 720, 1080, 1440]} sizes="(max-width: 579px) 540px, (max-width: 1023px) 720px, (max-width: 1600px) 1080px, 1440px" quality={90} loading="lazy" />
        ) : null}
      </div>
    </div>
  </div>
</section>

<style>
  .case_images-section {
    width: 100%;
    padding: 0 1.5rem;
  }

  .case_images-stack {
    max-width: var(--page-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .case_image {
    width: 100%;
    overflow: hidden;
  }

  .case_image img,
  .case_image video {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Mobile: tudo empilhado em coluna, ratio natural das imagens */
  .case_image-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  /* Tablet + Desktop: aspect fixo + object-fit cover */
  @media (min-width: 580px) {
    .case_image img,
    .case_image video {
      height: 100%;
      object-fit: cover;
    }
    .case_image--full {
      aspect-ratio: 1250 / 590;
    }
    .case_image-row {
      flex-direction: row;
      gap: 1.5rem;
    }
    .case_image--half {
      flex: 1 1 0;
      min-width: 0;
      aspect-ratio: 617.5 / 590;
    }
  }
</style>
