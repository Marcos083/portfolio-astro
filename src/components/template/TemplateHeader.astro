---
/**
 * TemplateHeader.astro — Foto do Marcos.
 * Desktop (277:135): 372×372 alinhada à esquerda no shell, atrelada ao 100vh.
 * Tablet   (1:249):  297×297 no topo, alinhada à esquerda.
 * Mobile   (1:379):  345×345 (full-width do container), depois do H1.
 */
import { Image } from 'astro:assets';
import navPhoto from '@/assets/template/marcos-nav.webp';
---

<section class="header_section">
  <div class="header_contain">
    <div class="header_logo-row">
      <Image
        class="header_photo"
        src={navPhoto}
        alt="Marcos Costa"
        widths={[240, 540, 720]}
        sizes="(max-width: 720px) 540px, 720px"
        quality={80}
      />
    </div>
  </div>
</section>

<style>
  .header_section {
    width: 100%;
    padding: 0 1.5rem;
  }

  .header_contain {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 1.5rem 0 0;
  }

  .header_logo-row {
    display: flex;
    align-items: flex-start;
  }

  /* Mobile: foto full-width do container, quadrada */
  .header_photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    object-fit: cover;
    display: block;
  }

  /* Tablet: 297×297 alinhada à esquerda */
  @media (min-width: 580px) {
    .header_photo {
      width: 29.7rem;
      height: 29.7rem;
      aspect-ratio: 1 / 1;
    }
  }

  /* Desktop: 372×372, ancorada ao 100vh via hero_shell */
  @media (min-width: 1024px) {
    .header_photo {
      width: 37.2rem;
      height: 37.2rem;
      max-width: min(37.2rem, 45vh);
      max-height: min(37.2rem, 45vh);
    }
  }
</style>
