---
/**
 * TemplateProjectCard.astro — project card with infinite media carousel
 * Todas medidas em rem (1rem = 10px @ 1280).
 * Carousel: 3 media items (images + videos) duplicated for seamless loop.
 * GSAP-driven continuous marquee (no hover pause).
 */
interface MediaItem {
  type: 'image' | 'video';
  src: string;
  alt?: string;
}

import { Image } from 'astro:assets';
import ArrowRight from '../ArrowRight.astro';

interface Props {
  label?: string;
  projectName: string;
  projectRole: string;
  description: string;
  ctaText?: string;
  ctaHref?: string;
  media: MediaItem[];
}

const {
  label = 'Project',
  projectName,
  projectRole,
  description,
  ctaText = 'See Project',
  ctaHref = '#',
  media,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/template/**/*.{jpeg,jpg,png,webp}');

const resolveImage = (src: string) => {
  const resolver = images[`/src/assets${src}`];
  return resolver ? resolver() : null;
};
---

<article class="project_item">
  <div class="project_image-strip" data-carousel>
    <div class="project_images carousel-track">
      {/* Original set */}
      {media.map((item) => (
        <div class="project_image">
          {item.type === 'image' && resolveImage(item.src) ? (
            <Image src={resolveImage(item.src)!} alt={item.alt || projectName} loading="lazy" decoding="async" />
          ) : item.type === 'video' ? (
            <video muted loop playsinline preload="metadata" data-autoplay>
              <source src={item.src} type="video/mp4" />
            </video>
          ) : null}
        </div>
      ))}
      {/* Duplicate set for seamless loop */}
      {media.map((item) => (
        <div class="project_image" aria-hidden="true">
          {item.type === 'image' && resolveImage(item.src) ? (
            <Image src={resolveImage(item.src)!} alt="" loading="lazy" decoding="async" />
          ) : item.type === 'video' ? (
            <video muted loop playsinline preload="metadata" data-autoplay>
              <source src={item.src} type="video/mp4" />
            </video>
          ) : null}
        </div>
      ))}
    </div>
  </div>

  <div class="project_details">
    <div class="project_meta">
      <span class="project_label">{label}</span>
      <div class="project_titles">
        <span class="project_name">{projectName}</span>
        <span class="project_role">{projectRole}</span>
      </div>
    </div>
    <div class="project_body">
      <p class="project_description">{description}</p>
      <a class="project_link arrow-link" href={ctaHref}>
        <span class="showText">
          <span>
            {ctaText} <ArrowRight />
            <span>{ctaText} <ArrowRight /></span>
          </span>
        </span>
      </a>
    </div>
  </div>
</article>

<style>
  /* ============ MOBILE (base) ============ */
  .project_item {
    width: 100%;
    max-width: 125rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 5rem;
  }

  .project_image-strip {
    width: 100%;
    height: 27.5rem;
    overflow: hidden;
    cursor: default;
  }

  .carousel-track {
    display: flex;
    gap: 2rem;
    height: 100%;
    will-change: transform;
  }

  .project_image {
    width: 28.5rem;
    height: 27.5rem;
    overflow: hidden;
    flex-shrink: 0;
  }

  .project_image img,
  .project_image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mobile: meta e body empilhados */
  .project_details {
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
    padding-top: 1rem;
  }

  .project_meta {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.6rem;
    max-width: 100%;
  }

  .project_label {
    font-family: var(--font-sans);
    font-size: var(--type-h10-size);
    font-weight: var(--type-h10-weight);
    line-height: var(--type-h10-lh);
    letter-spacing: var(--type-h10-ls);
    color: var(--color-background-2);
    padding-top: 0.2rem;
  }

  .project_titles {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project_name {
    font-family: var(--font-sans);
    font-size: var(--type-h8-size);
    font-weight: var(--type-h8-weight);
    line-height: var(--type-h8-lh);
    letter-spacing: var(--type-h8-ls);
    color: var(--color-text);
  }

  .project_role {
    font-family: var(--font-sans);
    font-size: var(--type-h10-size);
    font-weight: var(--type-h10-weight);
    line-height: var(--type-h10-lh);
    letter-spacing: var(--type-h10-ls);
    color: var(--color-background-2);
  }

  .project_body {
    width: 100%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ============ TABLET (≥580) ============ */
  @media (min-width: 580px) {
    .project_item {
      padding-bottom: 5rem;
    }
    .project_image-strip {
      height: 34rem;
    }
    .project_image {
      width: 34rem;
      height: 34rem;
    }
    .project_details {
      flex-direction: row;
      justify-content: space-between;
      gap: 3rem;
      padding-top: 2rem;
    }
    .project_meta {
      max-width: 34.1rem;
    }
    .project_body {
      width: 31.6rem;
      gap: 3rem;
    }
  }

  /* ============ DESKTOP (≥1024) ============ */
  @media (min-width: 1024px) {
    .project_item {
      padding-bottom: 8.8rem;
    }
    .project_image-strip {
      height: 44.6rem;
    }
    .project_image {
      width: 46.125rem;
      height: 44.6rem;
    }
    .project_details {
      gap: 4rem;
    }
    .project_body {
      justify-content: space-between;
      min-height: 14rem;
      gap: 0;
    }
  }

  .project_description {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--type-h10-size);
    font-weight: var(--type-h10-weight);
    line-height: var(--type-h10-lh);
    letter-spacing: var(--type-h10-ls);
    color: var(--color-text);
  }

  .project_link {
    margin-top: 1.5rem;
    font-family: var(--font-sans);
    font-size: var(--type-text-link-size);
    font-weight: var(--type-text-link-weight);
    line-height: var(--type-text-link-lh);
    letter-spacing: var(--type-text-link-ls);
    color: var(--color-text);
    align-self: flex-start;
  }
</style>
