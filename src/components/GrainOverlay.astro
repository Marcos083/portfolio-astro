---
/**
 * GrainOverlay — grain analógico altamente otimizado para performance.
 * Substitui o SVG feTurbulence (pesado) por um CSS background animado.
 */

interface Props {
  opacity?: number;
  blend?: 'multiply' | 'overlay' | 'soft-light' | 'screen' | 'normal';
  animated?: boolean;
  speed?: number; // legacy prop
  frames?: number; // legacy prop
}

const {
  opacity = 0.08,
  blend = 'multiply',
  animated = true,
  // speed and frames ignored in the new CSS approach
} = Astro.props;

---

<div
  class={`grain-overlay ${animated ? 'is-animated' : ''}`}
  aria-hidden="true"
  style={`--grain-opacity: ${opacity}; --grain-blend: ${blend};`}
>
</div>

<style>
  .grain-overlay {
    position: fixed;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    z-index: 9998;
    pointer-events: none;
    opacity: var(--grain-opacity, 0.08);
    mix-blend-mode: var(--grain-blend, multiply);
    
    /* Base64 noise image (extremely lightweight, ~200 bytes) */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
  }

  .grain-overlay.is-animated {
    animation: grainAnimation 1s steps(4) infinite;
  }

  @keyframes grainAnimation {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-5%, -5%); }
    50% { transform: translate(-10%, 5%); }
    75% { transform: translate(5%, -10%); }
    100% { transform: translate(-5%, 5%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .grain-overlay.is-animated {
      animation: none;
    }
  }
</style>
