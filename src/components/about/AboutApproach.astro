---
/**
 * AboutApproach.astro — Seção "Approach" com 3 princípios numerados.
 * Layout base: grid 625 | 625 (label esquerda, lista direita).
 * Toque Awwwards:
 *   - Números grandes (01/02/03) como âncora visual, cor muted
 *   - Cada princípio com título forte + descrição
 *   - Dividers hairline entre princípios (mesmo pattern de Awards no template)
 *   - Layout do item: número esq + [título + body] direita, alinhados no topo
 */

const principles = [
  {
    n: '01',
    title: 'Design and dev by the same hand.',
    body: 'The best sites feel authored, not assembled. When one person carries a project from concept to code, every decision keeps the same intent. The result is something people can actually feel, not just use.',
  },
  {
    n: '02',
    title: 'The details are the product.',
    body: 'The transition, the space between words, the way a button responds when you touch it. Those are the moments that make someone remember a site, not the features listed on the homepage.',
  },
  {
    n: '03',
    title: 'If it doesn\'t feel alive, it doesn\'t go live.',
    body: 'A page that just loads is a page nobody notices. Motion, transitions, tiny reactions to what someone does. That\'s how a site stops feeling like a document and starts feeling like a place.',
  },
];
---

<section class="about_approach">
  <div class="about_approach-contain">
    <div class="line-reveal line-reveal--top"></div>
    <div class="about_approach-grid">
      <div class="about_approach-left">
        <h2 class="about_approach-label fadeUp-mask"><span class="fadeUp">Approach</span></h2>
      </div>
      <div class="about_approach-right">
        {principles.map((p, i) => (
          <>
            {i > 0 && <div class="about_approach-divider"></div>}
            <div class="about_approach-item">
              <span class="about_approach-num">{p.n}</span>
              <div class="about_approach-body">
                <h3 class="about_approach-title">{p.title}</h3>
                <p class="about_approach-desc">{p.body}</p>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about_approach {
    width: 100%;
    padding: 0 1.5rem;
  }

  .about_approach-contain {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 4rem 0 6rem;
    position: relative;
  }

  /* Mobile: coluna única */
  .about_approach-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-top: 3rem;
  }

  .about_approach-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 3rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .about_approach-right {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
    max-width: 56rem;
  }

  .about_approach-item {
    display: grid;
    grid-template-columns: 4.4rem 1fr;
    gap: 1.6rem;
    align-items: baseline;
  }

  .about_approach-num {
    font-family: var(--font-sans);
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--color-background-2);
  }

  .about_approach-body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .about_approach-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .about_approach-desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--color-background-2);
  }

  .about_approach-divider {
    height: 1px;
    width: 100%;
    background: var(--color-divider-lines);
    margin: 0.6rem 0;
  }

  /* Tablet: 2 colunas 1fr | 1fr */
  @media (min-width: 580px) {
    .about_approach-contain {
      padding: 5rem 0 8rem;
    }
    .about_approach-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding-top: 4rem;
    }
    .about_approach-label {
      font-size: 4.4rem;
    }
    .about_approach-item {
      grid-template-columns: 5rem 1fr;
      gap: 2rem;
    }
    .about_approach-title {
      font-size: 2.2rem;
    }
    .about_approach-desc {
      font-size: 1.6rem;
    }
  }

  /* Desktop: label H1 style, número mais destacado, gaps generosos */
  @media (min-width: 1024px) {
    .about_approach-contain {
      padding: 6rem 0 10rem;
    }
    .about_approach-grid {
      grid-template-columns: 62.5rem 1fr;
      padding-top: 5rem;
    }
    .about_approach-label {
      font-size: 6.4rem;
      letter-spacing: -0.05em;
    }
    .about_approach-right {
      max-width: 56rem;
      gap: 3.2rem;
    }
    .about_approach-item {
      grid-template-columns: 6rem 1fr;
      gap: 2.4rem;
      align-items: baseline;
    }
    .about_approach-num {
      font-size: 1.6rem;
    }
    .about_approach-body {
      gap: 1.2rem;
    }
    .about_approach-title {
      font-size: 2.4rem;
      line-height: 1.25;
    }
    .about_approach-desc {
      font-size: 1.8rem;
      line-height: 1.45;
    }
    .about_approach-divider {
      margin: 0.8rem 0;
    }
  }
</style>
