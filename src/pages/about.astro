---
/**
 * /about — Página About do portfólio.
 * Estrutura:
 *   Nav (mesmo da home)
 *   AboutBio (statement + 5 polaroids arrastáveis)
 *   AboutServices (My Services · Development / Design / SEO)
 *   AboutClients (Selected Clients)
 *   AboutStory (bio narrativa)
 *   AboutApproach (3 princípios)
 *   Connect (footer CTA)
 *   Footer (mesmo da home)
 */
import TemplateNav from '@/components/template/TemplateNav.astro';
import AboutBio from '@/components/about/AboutBio.astro';
import AboutServices from '@/components/about/AboutServices.astro';
import AboutStory from '@/components/about/AboutStory.astro';
import AboutApproach from '@/components/about/AboutApproach.astro';
import CaseConnect from '@/components/case/CaseConnect.astro';
import TemplateFooter from '@/components/template/TemplateFooter.astro';
import GlobalEffects from '@/components/GlobalEffects.astro';
import PageTransition from '@/components/PageTransition.astro';
import SmoothScroll from '@/components/SmoothScroll.astro';
import GrainOverlay from '@/components/GrainOverlay.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/template-tokens.css';
import '../styles/fonts.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>About | Marcos Costa</title>

    <ClientRouter />
  </head>

  <body>
    <PageTransition />
    <TemplateNav />
    <AboutBio />
    <AboutServices />
    <AboutStory />
    <AboutApproach />
    <CaseConnect />
    <TemplateFooter />
    <GlobalEffects />
    <SmoothScroll />
    <GrainOverlay opacity={0.28} blend="multiply" animated={true} speed={0.5} frames={10} />
  </body>
</html>

<style is:global>
  :root { color-scheme: light only; }

  html { font-size: 2.66667vw; }
  @media (min-width: 580px) and (max-width: 1023px) { html { font-size: 1.25vw; } }
  @media (min-width: 1024px) { html { font-size: 0.78125vw; } }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  * { box-sizing: border-box; }
  img { display: block; max-width: 100%; }
</style>

