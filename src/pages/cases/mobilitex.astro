---
/**
 * /cases/mobilitex — Case Study Mobilitex
 * Layout do case study template. Slot 2 reusa /cases/mobilitex/1.webp (phone mockup da home),
 * Slot 3 usa o vídeo da home.
 */
import CaseNav from '@/components/case/CaseNav.astro';
import CaseTitle from '@/components/case/CaseTitle.astro';
import CaseImages from '@/components/case/CaseImages.astro';
import CaseOtherProjects from '@/components/case/CaseOtherProjects.astro';
import CaseConnect from '@/components/case/CaseConnect.astro';
import TemplateFooter from '@/components/template/TemplateFooter.astro';
import GlobalEffects from '@/components/GlobalEffects.astro';
import PageTransition from '@/components/PageTransition.astro';
import SmoothScroll from '@/components/SmoothScroll.astro';
import GrainOverlay from '@/components/GrainOverlay.astro';
import { ClientRouter } from 'astro:transitions';
import '../../styles/template-tokens.css';
import '../../styles/fonts.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Mobilitex | Marcos Costa</title>

    <link rel="preload" href="/fonts/InstrumentSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />
  </head>

  <body>
    <PageTransition />
    <CaseNav logoSrc="/cases/mobilitex/study/logo.png" logoAlt="Mobilitex logo" logoHeight={2.8} />

    <CaseTitle
      caseName="Mobilitex"
      description="Mobilitex is a leading Brazilian company in smart infrastructure for tunnels and highways. They needed to translate their technical complexity into a matching digital experience. I redesigned the interface in Webflow and built custom GSAP interactions, including a case gallery with drag, inertia, and cinematic transitions."
      techStack={[
        'Webflow',
        'GSAP',
        'CMS Architecture',
        'Cinematic transitions',
      ]}
      liveProjectHref="https://mobilitex.com.br/"
      liveProjectName="Live project"
    />

    <CaseImages
      media={[
        { type: 'image', src: '/cases/mobilitex/study/image-1.webp', alt: 'Mobilitex — wordmark hero' },
        { type: 'image', src: '/cases/mobilitex/1.webp',           alt: 'Mobilitex — phone mockup' },
        { type: 'video', src: 'https://github.com/Marcos083/portfolio-assets/releases/download/v1/mobilitex.mp4' },
        { type: 'image', src: '/cases/mobilitex/study/image-4.webp', alt: 'Mobilitex — meeting page mockup' },
        { type: 'image', src: '/cases/mobilitex/study/image-5.webp', alt: 'Mobilitex — content section' },
        { type: 'image', src: '/cases/mobilitex/study/image-6.webp', alt: 'Mobilitex — device gallery mockup' },
      ]}
    />

    <CaseOtherProjects
      projects={[
        {
          name: 'Gabriel Granjeiro',
          imageSrc: '/cases/gabriel-granjeiro/1.webp',
          imageAlt: 'Gabriel Granjeiro project preview',
          href: '/cases/gabriel-granjeiro',
        },
        {
          name: 'ARBA',
          imageSrc: '/cases/arba/1.webp',
          imageAlt: 'ARBA project preview',
          href: '/cases/arba',
        },
        {
          name: 'Bia & Gabriel',
          imageSrc: '/cases/biagabriel/1.webp',
          imageAlt: 'Bia & Gabriel project preview',
          href: '/cases/biagabriel',
        },
      ]}
    />

    <CaseConnect />

    <TemplateFooter />
    <GlobalEffects />
    <SmoothScroll />
    <GrainOverlay opacity={0.28} blend="multiply" animated={true} speed={0.5} frames={10} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light only;
  }

  html {
    font-size: 2.66667vw;
  }
  @media (min-width: 580px) and (max-width: 1023px) {
    html {
      font-size: 1.25vw;
    }
  }
  @media (min-width: 1024px) {
    html {
      font-size: 0.78125vw;
    }
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  img {
    display: block;
    max-width: 100%;
  }
</style>

